generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  DOCTOR
}

model users {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journals journals[]
}

model moods {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  icon        String?
  description String?

  journals journals[]
}

model journals {
  id        String   @id @default(cuid())
  userId    String
  moodId    String?
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user users  @relation(fields: [userId], references: [id])
  mood moods? @relation(fields: [moodId], references: [id])
}
