generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  DOCTOR
}

model users {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journals journals[]
}

model moods {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  icon        String?
  description String?

  journals journals[]
}

model journals {
  id        String   @id @default(cuid())
  userId    String
  moodId    String?
  title     String
  content   String
  attachments JournalAttachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user users  @relation(fields: [userId], references: [id] , onDelete : Cascade)
  mood moods? @relation(fields: [moodId], references: [id])
}


enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
}

model JournalAttachment {
  id        String  @id @default(cuid())
  url       String
  publicId  String
  attachmentType      AttachmentType
  journalId String
  createdAt DateTime @default(now())

  journal journals @relation(fields: [journalId], references: [id] , onDelete : Cascade)

  @@index([journalId])
}

model library {
  id       String   @id @default(cuid())
  title     String
  description  String
  imageUrl    String
  content    String?
  url    String?
  categoryId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category categoryLibrary @relation(fields: [categoryId] , references: [id] )
}

model categoryLibrary {
  id       String   @id @default(cuid())
  name      String  
  slug      String   @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  library library[]

}


model libraryMood {
  id      String  @id @default(cuid())
  moodId    String
  libraryId  String

  mood moods @relation(fields: [moodId] , references: [id] )
  library library @relation(fields: [libraryId] , references: [id] )
}
