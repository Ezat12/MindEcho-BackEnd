enum Role {
  CLIENT
  ADMIN
  DOCTOR
}

model users {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctors?
  journals journals[]
}
