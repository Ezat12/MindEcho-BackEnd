model library {
  id       String   @id @default(cuid())
  title     String
  description  String
  imageUrl    String
  imagePublicId  String
  content    String?
  url    String?
  urlPublicId String?
  categoryId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraryMood libraryMood[]
  category categoryLibrary @relation(fields: [categoryId] , references: [id]  )

}
