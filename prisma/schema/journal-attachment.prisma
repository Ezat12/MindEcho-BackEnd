enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
}

model JournalAttachment {
  id        String  @id @default(cuid())
  url       String
  publicId  String
  attachmentType      AttachmentType
  journalId String
  createdAt DateTime @default(now())

  journal journals @relation(fields: [journalId], references: [id] , onDelete : Cascade)

  @@index([journalId])
}
